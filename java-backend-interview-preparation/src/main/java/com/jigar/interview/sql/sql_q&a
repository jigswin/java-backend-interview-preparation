WHERE vs HAVING
 -> WHERE → individual rows ko filter karta hai.
 -> HAVING -> GROUP BY ke baad groups ko filter karta hai.


* Pehle ₹50,000 se zyada salary wale employees filter karo → phir unko department-wise group karo.
select department, count(*)
from employee
where salary > 50000
group by department;


* Pehle department-wise grouping karo → phir sirf woh departments rakho jahan employees 5 se zyada hain
SELECT department, COUNT(*)
FROM Employee
GROUP BY department
HAVING COUNT(*) > 5;

* Aise departments find karo jisme 1 se zyada employees hain.
SELECT dept_id, COUNT(*)
FROM Employee
GROUP BY dept_id
HAVING COUNT(*) > 1;

* Company ki total salary, average salary, highest salary aur lowest salary ek hi query me nikalo.
SELECT
    SUM(salary) AS total_salary,
    AVG(salary) AS average_salary,
    MAX(salary) AS max_salary,
    MIN(salary) AS min_salary
FROM Employee;


* Second highest salary find karo.
SELECT DISTINCT salary
FROM Employee
ORDER BY salary DESC
OFFSET 1
LIMIT 1;


* Aisi salaries find karo jo ek se zyada employees ko mili hain.
SELECT  salary, count(*)
FROM employee
GROUP BY salary
HAVING count(*) > 1

