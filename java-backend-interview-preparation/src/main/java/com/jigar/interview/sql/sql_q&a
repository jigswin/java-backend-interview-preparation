WHERE vs HAVING
 -> WHERE → individual rows ko filter karta hai.
 -> HAVING -> GROUP BY ke baad groups ko filter karta hai.


* Pehle ₹50,000 se zyada salary wale employees filter karo → phir unko department-wise group karo.
select department, count(*)
from employee
where salary > 50000
group by department;


