* Aise email addresses find karo jo multiple employees ke paas hain.

select email count(*) as frequency
from employee
group by email
having count(*) > 1


* Aise employees find karo jinki salary company ki average salary se zyada hai.
select * from employee
where salary > (select avg(salary) from employee);


* Har department ke employees me se un employees ko find karo jinki salary apne department ki average salary se zyada hai.
select * from employee as e
where salary > (
                select avg(e2.salary)
                from employee as e2
                where e.dept_id  = e2.dept_id
                )


* Har department ka naam aur us department ki average salary nikalo, lekin sirf wahi departments dikhao jinki average salary ₹60,000 se zyada hai.
select d.department_name, avg(e.salary) from employee as e
inner join department as d on e.dept_id = d.dept_id
group by d.dept_id, d.department_name
having avg(e.salary) > 60000;


* Employee table me second highest salary wale employee ka naam aur salary nikalo. (ye nth vale sabke liye chalega permanent solution h )
SELECT name, salary
FROM Employee
WHERE salary = (
    SELECT DISTINCT salary
    FROM Employee
    ORDER BY salary DESC
    LIMIT 1 OFFSET 1
);



